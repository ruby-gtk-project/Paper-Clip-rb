# The port installs upstream's bundled symbolic icons as a filesystem icon
# theme rather than as a GResource: Application.register_icons adds this
# directory to the GtkIconTheme search path at startup, which is the Ruby
# equivalent of upstream's gtk_icon_theme_add_resource_path.
[Icon Theme]
Name=Hicolor
Comment=Fallback icon theme
Directories=scalable/actions,scalable/apps,symbolic/apps

[scalable/actions]
Size=16
MinSize=8
MaxSize=512
Context=Actions
Type=Scalable

[scalable/apps]
Size=128
MinSize=8
MaxSize=512
Context=Applications
Type=Scalable

[symbolic/apps]
Size=16
MinSize=8
MaxSize=512
Context=Applications
Type=Scalable
